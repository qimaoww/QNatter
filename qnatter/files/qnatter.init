#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

NAME="qnatter"
RUNNER="/usr/share/qnatter/qnatter-run"
CONF="qnatter"
RUN_DIR="${QNATTER_RUN_DIR:-/var/run/qnatter}"
LOG_DIR="${QNATTER_LOG_DIR:-/var/log/qnatter}"

: "${QNATTER_FUNCTIONS_SH:=/lib/functions.sh}"
: "${QNATTER_NETWORK_SH:=/lib/functions/network.sh}"
: "${QNATTER_COMMON_SH:=/usr/share/qnatter/qnatter-common.sh}"
: "${QNATTER_QBITTORRENT_SH:=/usr/share/qnatter/qnatter-qbittorrent.sh}"
: "${QNATTER_NFT_BIN:=nft}"
: "${QNATTER_IP_BIN:=ip}"
: "${QNATTER_UCI_BIN:=uci}"
: "${QNATTER_UBUS_BIN:=ubus}"
: "${QNATTER_INIT_BIN:=/etc/init.d/qnatter}"
: "${QNATTER_LOCK_FILE:=/var/lock/qnatter.lock}"
# procd respawn 额度（threshold:timeout:retry）：连续 retry 次在 threshold 秒内
# 退出后 procd 永久放弃重启。qnatter-run 会读取同名参数做失败计数与告警，
# 两边必须保持一致（qnatter-run 的默认值也是 3600/5）。
: "${QNATTER_RESPAWN_THRESHOLD:=3600}"
: "${QNATTER_RESPAWN_TIMEOUT:=5}"
: "${QNATTER_RESPAWN_RETRY:=5}"

. "$QNATTER_FUNCTIONS_SH"
. "$QNATTER_NETWORK_SH"
. "$QNATTER_COMMON_SH"
. "$QNATTER_QBITTORRENT_SH"

# config_foreach 的返回值只反映"最后一次回调"：/lib/functions.sh 内部是
# `[ "$type" = "$cfgtype" ] && "$callback" "$section"`，前面几次回调的返回值被
# 丢弃。因此 `config_foreach cb instance || return 1` 只能捕获最后一个实例段的
# 失败，前面实例的失败会被静默吞掉（SH-P2-1）。统一改走 qnatter_foreach_instance：
# 逐实例累计失败标记，任一实例失败即置位，同时为每个失败实例单独写一条 syslog。
QNATTER_FOREACH_FAILED=0
QNATTER_FOREACH_CALLBACK=""

qnatter_foreach_instance_dispatch() {
	local section="$1"

	"$QNATTER_FOREACH_CALLBACK" "$section" || {
		QNATTER_FOREACH_FAILED=1
		qnatter_warn "qnatter: instance ${section} failed in ${QNATTER_FOREACH_CALLBACK}"
	}
	return 0
}

qnatter_foreach_instance() {
	local callback="$1"
	local type="${2:-instance}"

	QNATTER_FOREACH_FAILED=0
	QNATTER_FOREACH_CALLBACK="$callback"
	config_foreach qnatter_foreach_instance_dispatch "$type"
	return 0
}

# 任一实例失败即非 0；调用方（start_service / reload 各阶段）据此中止或回退。
qnatter_instances_failed() {
	[ "${QNATTER_FOREACH_FAILED:-0}" = "1" ]
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	QNATTER_TRIGGER_NETWORKS=""
	config_load "$CONF"
	config_foreach qnatter_add_interface_trigger instance
	unset QNATTER_TRIGGER_NETWORKS
}

qnatter_record_interface_trigger() {
	local network="$1"

	[ -n "$network" ] || return 0
	case " ${QNATTER_TRIGGER_NETWORKS:-} " in
		*" $network "*) return 0 ;;
	esac

	QNATTER_TRIGGER_NETWORKS="${QNATTER_TRIGGER_NETWORKS:-} $network"
	procd_add_interface_trigger "interface.*.up" "$network" /etc/init.d/qnatter reload
}

qnatter_add_interface_trigger() {
	local section="$1"
	local enabled network bind_value

	qnatter_config_get_bool enabled "$section" enabled 0
	[ "$enabled" = "1" ] || return 0
	qnatter_config_get bind_value "$section" bind_value ""
	qnatter_config_get network "$section" network "wan"
	[ -n "$network" ] || network="wan"
	qnatter_record_interface_trigger "$network"
}

qnatter_resolve_bind_value() {
	local configured="$2"

	if [ -n "$configured" ]; then
		printf '%s\n' "$configured"
		return 0
	fi
}

qnatter_ipv4_literal() {
	case "$1" in
		''|*[!0-9.]*|*.*.*.*.*) return 1 ;;
		*.*.*.*) return 0 ;;
	esac
	return 1
}

qnatter_bind_fingerprint_device() {
	local network="$1"
	local bind_value="$2"
	local resolved_device

	if [ -n "$bind_value" ]; then
		qnatter_ipv4_literal "$bind_value" && return 0
		printf '%s\n' "$bind_value"
		return 0
	fi

	if network_get_device resolved_device "$network" >/dev/null 2>&1 && [ -n "$resolved_device" ]; then
		printf '%s\n' "$resolved_device"
	fi
}

qnatter_device_ipv4() {
	local device="$1"

	[ -n "$device" ] || return 0
	command -v "$QNATTER_IP_BIN" >/dev/null 2>&1 || return 0
	"$QNATTER_IP_BIN" -4 -o addr show dev "$device" scope global 2>/dev/null | awk '
		$3 == "inet" {
			sub(/\/.*/, "", $4)
			print $4
			exit
		}
	'
}

qnatter_bind_fingerprint_ipv4() {
	local bind_value="$1"
	local device="$2"

	if qnatter_ipv4_literal "$bind_value"; then
		printf '%s\n' "$bind_value"
		return 0
	fi
	qnatter_device_ipv4 "$device"
}

qnatter_flush_runtime_rules() {
	command -v "$QNATTER_NFT_BIN" >/dev/null 2>&1 || return 0

	"$QNATTER_NFT_BIN" flush chain ip qnatter qnatter_dnat >/dev/null 2>&1 || true
	"$QNATTER_NFT_BIN" flush chain ip qnatter qnatter_snat >/dev/null 2>&1 || true
	"$QNATTER_NFT_BIN" flush chain ip qnatter qnatter_mark >/dev/null 2>&1 || true
}

qnatter_flush_route_rules() {
	local line priority mark table

	command -v "$QNATTER_IP_BIN" >/dev/null 2>&1 || return 0
	"$QNATTER_IP_BIN" rule show 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			*" fwmark 0x4e000"*" lookup "*) ;;
			*) continue ;;
		esac

		priority="${line%%:*}"
		mark="${line#* fwmark }"
		mark="${mark%% *}"
		table="${line##* lookup }"
		table="${table%% *}"
		case "$priority$table" in
			''|*[!0-9]*) continue ;;
		esac
		case "$mark" in
			0x4e000???) ;;
			*) continue ;;
		esac

		# 尽量带上 fwmark/lookup 选择器，只删 QNatter 自己装的那条规则，避免误删
		# 恰好同 priority 的第三方策略路由；busybox 的 ip 若不支持选择器再退回旧写法。
		"$QNATTER_IP_BIN" rule del priority "$priority" fwmark "$mark" lookup "$table" >/dev/null 2>&1 ||
			"$QNATTER_IP_BIN" rule del priority "$priority" >/dev/null 2>&1 || true
		"$QNATTER_IP_BIN" route flush table "$table" >/dev/null 2>&1 || true
	done
}

# A plain `start` can be issued while procd still has the existing QNatter
# instances running (for example after a duplicate interface event).  Flushing
# the shared QNatter table in that case removes live mappings while the
# unchanged processes keep running and never recreate them.  Only perform the
# stale-rule cleanup when no backend instance is alive; an explicit reload or
# restart still handles changed instances through procd.
qnatter_backend_running() {
	if command -v "$QNATTER_UBUS_BIN" >/dev/null 2>&1 &&
		"$QNATTER_UBUS_BIN" call service list '{"name":"qnatter"}' 2>/dev/null |
		grep -q '"running"[[:space:]]*:[[:space:]]*true'; then
		return 0
	fi

	# procd 执行的是 qnatter-run -> /usr/bin/qnatter-go，进程名是 qnatter-go；
	# 旧代码只检查 pidof QNatter（仅 Makefile 里的符号链接名），永远判"未运行"。
	command -v pidof >/dev/null 2>&1 && {
		pidof qnatter-go >/dev/null 2>&1 || pidof QNatter >/dev/null 2>&1
	}
}

qnatter_route_slot_valid() {
	local slot="$1"

	case "$slot" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "$slot" in
		0|[1-9]*) ;;
		*) return 1 ;;
	esac
	[ "$slot" -le 4095 ] || return 1
}

qnatter_route_slot_used() {
	case " ${QNATTER_ROUTE_USED_SLOTS:-} " in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

qnatter_record_route_slot() {
	QNATTER_ROUTE_USED_SLOTS="${QNATTER_ROUTE_USED_SLOTS:-} $1"
}

qnatter_next_route_slot() {
	local slot=0

	while [ "$slot" -le 4095 ]; do
		if ! qnatter_route_slot_used "$slot"; then
			printf '%s\n' "$slot"
			return 0
		fi
		slot="$((slot + 1))"
	done

	return 1
}

qnatter_set_config_route_slot() {
	local section="$1"
	local slot="$2"

	# 框架 config_set 用 section 名拼变量名，含 '-'（UCI 合法）时会打印
	# "bad variable name" 且不生效；uci 的写入已经完成，这里跳过即可。
	case "$section" in
		''|*[!A-Za-z0-9_]*) return 0 ;;
	esac
	if command -v config_set >/dev/null 2>&1; then
		config_set "$section" route_slot "$slot"
	fi
}

qnatter_prepare_route_slot() {
	local section="$1"
	local slot new_slot

	qnatter_config_get slot "$section" route_slot ""
	if qnatter_route_slot_valid "$slot" && ! qnatter_route_slot_used "$slot"; then
		qnatter_record_route_slot "$slot"
		return 0
	fi

	new_slot="$(qnatter_next_route_slot)" || return 1
	"$QNATTER_UCI_BIN" set "${CONF}.${section}.route_slot=${new_slot}" >/dev/null 2>&1 || return 1
	qnatter_set_config_route_slot "$section" "$new_slot"
	QNATTER_ROUTE_SLOTS_CHANGED=1
	qnatter_record_route_slot "$new_slot"
}

qnatter_prepare_route_slots() {
	command -v "$QNATTER_UCI_BIN" >/dev/null 2>&1 || return 0

	QNATTER_ROUTE_USED_SLOTS=""
	QNATTER_ROUTE_SLOTS_CHANGED=0
	qnatter_foreach_instance qnatter_prepare_route_slot
	if qnatter_instances_failed; then
		unset QNATTER_ROUTE_USED_SLOTS QNATTER_ROUTE_SLOTS_CHANGED
		return 1
	fi

	if [ "$QNATTER_ROUTE_SLOTS_CHANGED" = "1" ]; then
		"$QNATTER_UCI_BIN" commit "$CONF" >/dev/null 2>&1 || {
			unset QNATTER_ROUTE_USED_SLOTS QNATTER_ROUTE_SLOTS_CHANGED
			return 1
		}
	fi

	unset QNATTER_ROUTE_USED_SLOTS QNATTER_ROUTE_SLOTS_CHANGED
	return 0
}

qnatter_assign_route_policy() {
	local slot="$1"

	if ! qnatter_route_slot_valid "$slot"; then
		slot="${QNATTER_ROUTE_SLOT:-0}"
		qnatter_route_slot_valid "$slot" || return 1
		QNATTER_ROUTE_SLOT="$((slot + 1))"
	fi

	QNATTER_ROUTE_MARK="$(printf '0x4e000%03x' "$slot")"
	QNATTER_ROUTE_TABLE="$((20000 + slot))"
	QNATTER_ROUTE_PRIORITY="$((20000 + slot))"
}

qnatter_firewall_dest_zone() {
	local forward_method="$1"
	local target_ip="$2"
	local qb_forward="$3"
	local qb_target_ip="$4"

	if [ "$qb_forward" = "1" ] && [ -n "$qb_target_ip" ] && [ "$qb_target_ip" != "0.0.0.0" ] && [ "$qb_target_ip" != "127.0.0.1" ]; then
		printf '%s\n' "lan"
		return 0
	fi

	case "$forward_method" in
		none|test)
			return 0
			;;
	esac

	if [ -n "$target_ip" ] && [ "$target_ip" != "0.0.0.0" ] && [ "$target_ip" != "127.0.0.1" ]; then
		printf '%s\n' "lan"
	fi
}

qnatter_write_notify_env() {
	local section="$1"
	local env_file="$2"
	local status_file="$3"
	local log_file="${4:-}"
	local qb_enabled qb_url qb_user qb_pass qb_forward qb_target_ip qb_target_port qb_forward_method
	local auto_firewall firewall_section firewall_name firewall_src firewall_dest
	local cf_enabled cf_api_url cf_api_token cf_zone_id cf_record_id
	local completion_webhook_enabled completion_webhook_url completion_webhook_timeout
	local completion_webhook_method completion_webhook_headers completion_webhook_body
	local completion_webhook_success completion_webhook_disable_success_check completion_webhook_skip_unchanged
	local completion_script_enabled completion_script_inline
	local forward_method target_ip

	qnatter_config_get_bool completion_webhook_enabled "$section" completion_webhook_enabled 0
	qnatter_config_get completion_webhook_url "$section" completion_webhook_url ""
	qnatter_config_get completion_webhook_timeout "$section" completion_webhook_timeout "8"
	qnatter_config_get completion_webhook_method "$section" completion_webhook_method "POST"
	qnatter_config_get completion_webhook_headers "$section" completion_webhook_headers "Content-Type: application/json"
	qnatter_config_get completion_webhook_body "$section" completion_webhook_body '{"event":"mapped","instance":"#{instance}","protocol":"#{protocol}","inner_ip":"#{inner_ip}","inner_port":#{inner_port},"outer_ip":"#{outer_ip}","outer_port":#{outer_port}}'
	qnatter_config_get completion_webhook_success "$section" completion_webhook_success ""
	qnatter_config_get_bool completion_webhook_disable_success_check "$section" completion_webhook_disable_success_check 1
	qnatter_config_get_bool completion_webhook_skip_unchanged "$section" completion_webhook_skip_unchanged 0
	qnatter_config_get_bool completion_script_enabled "$section" completion_script_enabled 0
	qnatter_config_get completion_script_inline "$section" completion_script_inline ""
	qnatter_config_get_bool auto_firewall "$section" auto_firewall 0
	qnatter_config_get forward_method "$section" forward_method "auto"
	qnatter_config_get target_ip "$section" target_ip "0.0.0.0"
	qnatter_config_get_bool cf_enabled "$section" cloudflare_enabled 0
	qnatter_config_get cf_api_url "$section" cloudflare_api_url ""
	qnatter_config_get cf_api_token "$section" cloudflare_api_token ""
	qnatter_config_get cf_zone_id "$section" cloudflare_zone_id ""
	qnatter_config_get cf_record_id "$section" cloudflare_record_id ""
	qnatter_config_get_bool qb_enabled "$section" qbittorrent_enabled 0
	qnatter_config_get qb_url "$section" qbittorrent_url ""
	qnatter_config_get qb_user "$section" qbittorrent_username ""
	qnatter_config_get qb_pass "$section" qbittorrent_password ""
	qnatter_config_get_bool qb_forward "$section" qbittorrent_forward 0
	qnatter_config_get qb_target_ip "$section" qbittorrent_target_ip ""
	qnatter_config_get qb_target_port "$section" qbittorrent_target_port "0"
	qnatter_config_get qb_forward_method "$section" qbittorrent_forward_method "nftables"
	firewall_section="qnatter_$(qnatter_runtime_slug "$section")"
	firewall_name="QNatter ${section}"
	firewall_src="wan"
	firewall_dest="$(qnatter_firewall_dest_zone "$forward_method" "$target_ip" "$qb_forward" "$qb_target_ip")"

	qnatter_qb_write_notify_env "$env_file" \
		QNATTER_INSTANCE "$section" \
		QNATTER_STATUS_FILE "$status_file" \
		QNATTER_LOG_FILE "$log_file" \
		QNATTER_AUTO_FIREWALL "$auto_firewall" \
		QNATTER_FIREWALL_SECTION "$firewall_section" \
		QNATTER_FIREWALL_NAME "$firewall_name" \
		QNATTER_FIREWALL_SRC "$firewall_src" \
		QNATTER_FIREWALL_DEST "$firewall_dest" \
		CLOUDFLARE_SRV_ENABLED "$cf_enabled" \
		CLOUDFLARE_API_URL "$cf_api_url" \
		CLOUDFLARE_API_TOKEN "$cf_api_token" \
		CLOUDFLARE_ZONE_ID "$cf_zone_id" \
		CLOUDFLARE_RECORD_ID "$cf_record_id" \
		QNATTER_COMPLETION_WEBHOOK_ENABLED "$completion_webhook_enabled" \
		QNATTER_COMPLETION_WEBHOOK_URL "$completion_webhook_url" \
		QNATTER_COMPLETION_WEBHOOK_TIMEOUT "$completion_webhook_timeout" \
		QNATTER_COMPLETION_WEBHOOK_METHOD "$completion_webhook_method" \
		QNATTER_COMPLETION_WEBHOOK_HEADERS "$completion_webhook_headers" \
		QNATTER_COMPLETION_WEBHOOK_BODY "$completion_webhook_body" \
		QNATTER_COMPLETION_WEBHOOK_SUCCESS "$completion_webhook_success" \
		QNATTER_COMPLETION_WEBHOOK_DISABLE_SUCCESS_CHECK "$completion_webhook_disable_success_check" \
		QNATTER_COMPLETION_WEBHOOK_SKIP_UNCHANGED "$completion_webhook_skip_unchanged" \
		QNATTER_COMPLETION_SCRIPT_ENABLED "$completion_script_enabled" \
		QNATTER_COMPLETION_SCRIPT_INLINE "$completion_script_inline" \
		QBITTORRENT_ENABLED "$qb_enabled" \
		QBITTORRENT_URL "$qb_url" \
		QBITTORRENT_USERNAME "$qb_user" \
		QBITTORRENT_PASSWORD "$qb_pass" \
		QBITTORRENT_FORWARD "$qb_forward" \
		QBITTORRENT_TARGET_IP "$qb_target_ip" \
		QBITTORRENT_TARGET_PORT "$qb_target_port" \
		QBITTORRENT_FORWARD_METHOD "$qb_forward_method"
}

qnatter_add_stun_server() {
	qnatter_append_stun_value stun_servers "$1"
}

qnatter_add_global_tcp_stun_server() {
	qnatter_append_stun_value QNATTER_GLOBAL_TCP_STUN_SERVERS "$1"
}

qnatter_add_global_udp_stun_server() {
	qnatter_append_stun_value QNATTER_GLOBAL_UDP_STUN_SERVERS "$1"
}

qnatter_append_stun_value() {
	local var="$1"
	local item="$2"
	local current
	local existing

	[ -n "$item" ] || return 0
	# UCI 列表值先过字符集白名单：'*'/'?'/空白/引号/以 '-' 开头的值都不能
	# 进入 qnatter-go 的参数列表（glob 展开与选项注入）。
	if ! qnatter_stun_value_allowed "$item"; then
		qnatter_warn "qnatter: ignoring unsupported STUN server value"
		return 0
	fi
	eval "current=\"\${${var}:-}\""
	qnatter_glob_disable
	for existing in $current; do
		if [ "$existing" = "$item" ]; then
			qnatter_glob_restore
			return 0
		fi
	done
	qnatter_glob_restore
	if [ -n "$current" ]; then
		current="${current} ${item}"
	else
		current="$item"
	fi
	eval "$var=\"\$current\""
}

qnatter_load_global_stun_servers() {
	QNATTER_GLOBAL_TCP_STUN_SERVERS=""
	QNATTER_GLOBAL_UDP_STUN_SERVERS=""
	config_list_foreach stun tcp_server qnatter_add_global_tcp_stun_server
	config_list_foreach stun udp_server qnatter_add_global_udp_stun_server
}

qnatter_add_selected_stun_server() {
	qnatter_append_stun_value selected "$1"
}

qnatter_select_stun_servers() {
	local protocol="$1"
	local instance_servers="$2"
	local selected=""

	# 逐项切分（qnatter_split_list 内部关闭 glob），避免列表值里的 '*'/'?'
	# 被展开成本地文件名。
	if [ -n "$instance_servers" ]; then
		qnatter_split_list qnatter_add_selected_stun_server "$instance_servers"
	fi
	if [ "$protocol" = "udp" ]; then
		qnatter_split_list qnatter_add_selected_stun_server "${QNATTER_GLOBAL_UDP_STUN_SERVERS:-}"
	else
		qnatter_split_list qnatter_add_selected_stun_server "${QNATTER_GLOBAL_TCP_STUN_SERVERS:-}"
	fi
	printf '%s\n' "$selected"
}

qnatter_write_runtime_fingerprint() {
	local file="$1"
	local section="$2"
	local network="$3"
	local log_file="$4"
	local bind_device="$5"
	local bind_ipv4="$6"
	local tmp="${file}.$$"
	local arg

	mkdir -p "$(dirname "$file")"
	{
		printf 'section=%s\n' "$section"
		printf 'runner=%s\n' "$RUNNER"
		printf 'network=%s\n' "$network"
		printf 'bind_device=%s\n' "$bind_device"
		printf 'bind_ipv4=%s\n' "$bind_ipv4"
		printf 'log_file=%s\n' "$log_file"
		printf 'respawn=%s:%s:%s\n' "$QNATTER_RESPAWN_THRESHOLD" "$QNATTER_RESPAWN_TIMEOUT" "$QNATTER_RESPAWN_RETRY"
		printf 'route_mark=%s\n' "${QNATTER_ROUTE_MARK:-}"
		printf 'route_table=%s\n' "${QNATTER_ROUTE_TABLE:-}"
		printf 'route_priority=%s\n' "${QNATTER_ROUTE_PRIORITY:-}"
		while IFS= read -r arg; do
			[ -n "$arg" ] || continue
			printf 'arg=%s\n' "$arg"
		done <<-EOF
			$QNATTER_ARGS
		EOF
	} > "$tmp" || {
		rm -f "$tmp"
		return 1
	}
	mv "$tmp" "$file" || {
		rm -f "$tmp"
		return 1
	}
}

qnatter_start_instance() {
	local section="$1"
	local enabled protocol network bind_value bind_port public_ip_mode forward_method
	local target_ip target_port keepalive_interval keepalive_server retry_target exit_when_changed
	local upnp verbose qb_enabled qb_forward qb_target_ip qb_target_port qb_forward_method
	local stun_servers slug log_file notify_env notify_wrapper status_file runtime_file resolved_bind route_slot
	local fingerprint_device fingerprint_ipv4

	qnatter_config_get_bool enabled "$section" enabled 0
	[ "$enabled" = "1" ] || return 0
	qnatter_config_get route_slot "$section" route_slot ""
	qnatter_assign_route_policy "$route_slot" || return 1

	qnatter_config_get protocol "$section" protocol "tcp"
	qnatter_config_get network "$section" network "wan"
	qnatter_config_get bind_value "$section" bind_value ""
	qnatter_config_get bind_port "$section" bind_port "0"
	qnatter_config_get public_ip_mode "$section" public_ip_mode "detected"
	qnatter_config_get forward_method "$section" forward_method "auto"
	qnatter_config_get target_ip "$section" target_ip "0.0.0.0"
	qnatter_config_get target_port "$section" target_port "0"
	qnatter_config_get keepalive_interval "$section" keepalive_interval "15"
	qnatter_config_get keepalive_server "$section" keepalive_server ""
	qnatter_config_get_bool retry_target "$section" retry_target 0
	qnatter_config_get_bool exit_when_changed "$section" exit_when_changed 0
	qnatter_config_get_bool upnp "$section" upnp 0
	qnatter_config_get_bool verbose "$section" verbose 0
	qnatter_config_get_bool qb_enabled "$section" qbittorrent_enabled 0
	qnatter_config_get_bool qb_forward "$section" qbittorrent_forward 0
	qnatter_config_get qb_target_ip "$section" qbittorrent_target_ip ""
	qnatter_config_get qb_target_port "$section" qbittorrent_target_port "0"
	qnatter_config_get qb_forward_method "$section" qbittorrent_forward_method "nftables"
	stun_servers=""
	config_list_foreach "$section" stun_server qnatter_add_stun_server
	stun_servers="$(qnatter_select_stun_servers "$protocol" "$stun_servers")"

	# 超长 section 名会让 "<slug>.env" 之类的文件名超过 NAME_MAX 而写入失败，
	# 这里限长后再落盘，并由 qnatter_write_notify_env 的返回值兜底。
	slug="$(qnatter_runtime_slug "$section" | cut -c 1-180)"
	mkdir -p "$RUN_DIR" "$LOG_DIR"
	log_file="${LOG_DIR}/${slug}.log"
	notify_env="${RUN_DIR}/${slug}.env"
	notify_wrapper="${RUN_DIR}/${slug}.notify"
	status_file="${RUN_DIR}/${slug}.json"
	runtime_file="${QNATTER_RUNTIME_DIR:-$RUN_DIR}/${slug}.runtime"
	resolved_bind="$(qnatter_resolve_bind_value "$network" "$bind_value")"
	fingerprint_device="$(qnatter_bind_fingerprint_device "$network" "$resolved_bind")"
	fingerprint_ipv4="$(qnatter_bind_fingerprint_ipv4 "$resolved_bind" "$fingerprint_device")"

	QNATTER_PROTOCOL="$protocol"
	QNATTER_VERBOSE="$verbose"
	QNATTER_EXIT_WHEN_CHANGED="$exit_when_changed"
	QNATTER_UPNP="$upnp"
	QNATTER_KEEPALIVE_INTERVAL="$keepalive_interval"
	QNATTER_STUN_SERVERS="$stun_servers"
	QNATTER_KEEPALIVE_SERVER="$keepalive_server"
	QNATTER_BIND_VALUE="$resolved_bind"
	QNATTER_BIND_PORT="$bind_port"
	QNATTER_FORWARD_METHOD="$forward_method"
	QNATTER_TARGET_IP="$target_ip"
	QNATTER_TARGET_PORT="$target_port"
	QNATTER_RETRY_TARGET="$retry_target"
	qnatter_write_notify_env "$section" "$notify_env" "$status_file" "$log_file" || {
		qnatter_warn "qnatter: cannot write notify env file for ${section}"
		return 1
	}
	if ! { cat > "$notify_wrapper" <<-EOF
		#!/bin/sh
		export QNATTER_NOTIFY_ENV='$notify_env'
		exec /usr/share/qnatter/qnatter-notify "\$@"
	EOF
	}; then
		qnatter_warn "qnatter: cannot write notify wrapper for ${section}"
		return 1
	fi
	if ! chmod 0700 "$notify_wrapper"; then
		qnatter_warn "qnatter: cannot secure notify wrapper for ${section}"
		return 1
	fi
	QNATTER_NOTIFY_PATH="$notify_wrapper"

	# Optional qBittorrent forwarding reuses QNatter's native forwarding: target
	# port 0 means QNatter forwards to the port reported after punching.
	if [ "$qb_forward" = "1" ] && [ -n "$qb_target_ip" ]; then
		QNATTER_FORWARD_METHOD="$qb_forward_method"
		QNATTER_TARGET_IP="$qb_target_ip"
		QNATTER_TARGET_PORT="$qb_target_port"
	fi

	qnatter_build_args
	qnatter_write_runtime_fingerprint "$runtime_file" "$section" "$network" "$log_file" "$fingerprint_device" "$fingerprint_ipv4" || return 1
	[ -n "${QNATTER_RUNTIME_LIST:-}" ] && printf '%s\n' "$slug" >> "$QNATTER_RUNTIME_LIST"
	[ "${QNATTER_PREPARE_ONLY:-0}" = "1" ] && return 0

	procd_open_instance "$section"
	procd_set_param command "$RUNNER" "$log_file"
	local arg
	while IFS= read -r arg; do
		[ -n "$arg" ] || continue
		procd_append_param command "$arg"
	done <<-EOF
		$QNATTER_ARGS
	EOF
	procd_set_param respawn "$QNATTER_RESPAWN_THRESHOLD" "$QNATTER_RESPAWN_TIMEOUT" "$QNATTER_RESPAWN_RETRY"
	procd_set_param env \
		QNATTER_INSTANCE="$section" \
		QNATTER_STATUS_FILE="$status_file" \
		QNATTER_ROUTE_MARK="$QNATTER_ROUTE_MARK" \
		QNATTER_ROUTE_TABLE="$QNATTER_ROUTE_TABLE" \
		QNATTER_ROUTE_PRIORITY="$QNATTER_ROUTE_PRIORITY"
	procd_set_param limits nofile="4096 4096"
	procd_set_param user root
	procd_set_param term_timeout 10
	procd_set_param nice 0
	procd_close_instance

	if [ "${QNATTER_RELOADING:-0}" != "1" ]; then
		echo "$(date '+%Y-%m-%d %H:%M:%S') starting ${section}: bind=${resolved_bind:-default route} public_ip=${public_ip_mode}" >> "$log_file"
	fi
}

# reload 的"读-改-写"序列（mktemp -> config_foreach -> ubus delete -> start ->
# cp）之间没有任何互斥：hotplug 与 procd 的 interface.*.up 触发器会对同一次
# ifup 各触发一次 reload，两个进程交错会出现"刚启动又被删除"的实例抖动。
# 抢不到锁时直接跳过本次 reload（另一次正在做同样的事）。预检可写是必需的：
# exec 的重定向失败会让 dash / busybox ash 直接退出 shell。
qnatter_lock_acquire() {
	[ "${QNATTER_LOCK_HELD:-0}" = "1" ] && return 0
	command -v flock >/dev/null 2>&1 || return 0
	if ! (umask 022; : >> "$QNATTER_LOCK_FILE") 2>/dev/null; then
		return 0
	fi
	exec 9>"$QNATTER_LOCK_FILE" 2>/dev/null
	if ! flock -n 9 2>/dev/null; then
		exec 9>&-
		return 1
	fi
	QNATTER_LOCK_HELD=1
	return 0
}

stop_service() {
	# procd 只负责终止进程：QNatter 注入的 nft 规则（ip qnatter 表）与策略路由
	# （fwmark 0x4e000xxx / table 2000x）必须显式回收，否则 stop 或进程被
	# SIGKILL 之后 DNAT 仍会把流量送到已经关闭的端口。
	qnatter_flush_runtime_rules
	qnatter_flush_route_rules
}

start_service() {
	local enabled

	config_load "$CONF"
	qnatter_config_get_bool enabled global enabled 0
	[ "$enabled" = "1" ] || return 0
	qnatter_load_global_stun_servers
	qnatter_prepare_route_slots || return 1
	mkdir -p "$RUN_DIR"
	if [ "${QNATTER_RELOADING:-0}" != "1" ] && ! qnatter_backend_running; then
		qnatter_flush_runtime_rules
		qnatter_flush_route_rules
	fi
	qnatter_start_instances
}

qnatter_start_instances() {
	local runtime_list_tmp failed

	runtime_list_tmp="${RUN_DIR}/.runtime-instances.$$"
	: > "$runtime_list_tmp"
	QNATTER_PREPARE_ONLY=0
	QNATTER_RUNTIME_DIR="$RUN_DIR"
	QNATTER_RUNTIME_LIST="$runtime_list_tmp"
	QNATTER_ROUTE_SLOT=0
	qnatter_foreach_instance qnatter_start_instance
	failed="$QNATTER_FOREACH_FAILED"
	mv "$runtime_list_tmp" "${RUN_DIR}/.runtime-instances"
	unset QNATTER_PREPARE_ONLY QNATTER_RUNTIME_DIR QNATTER_RUNTIME_LIST QNATTER_ROUTE_SLOT QNATTER_ROUTE_MARK QNATTER_ROUTE_TABLE QNATTER_ROUTE_PRIORITY
	if [ "$failed" = "1" ]; then
		qnatter_warn "qnatter: one or more instances failed to start; see the per-instance log for details"
		return 1
	fi
	return 0
}

qnatter_hot_reload_service() {
	local tmp runtime_list old_list old_sorted new_sorted slug

	config_load "$CONF"
	qnatter_load_global_stun_servers
	qnatter_prepare_route_slots || return 1
	mkdir -p "$RUN_DIR"
	tmp="$(mktemp -d "${RUN_DIR}/.reload.XXXXXX")" || return 1
	runtime_list="${tmp}/.runtime-instances"
	: > "$runtime_list"
	QNATTER_PREPARE_ONLY=1
	QNATTER_RUNTIME_DIR="$tmp"
	QNATTER_RUNTIME_LIST="$runtime_list"
	QNATTER_ROUTE_SLOT=0
	qnatter_foreach_instance qnatter_start_instance
	if qnatter_instances_failed; then
		rm -rf "$tmp"
		unset QNATTER_PREPARE_ONLY QNATTER_RUNTIME_DIR QNATTER_RUNTIME_LIST QNATTER_ROUTE_SLOT QNATTER_ROUTE_MARK QNATTER_ROUTE_TABLE QNATTER_ROUTE_PRIORITY
		return 1
	fi
	unset QNATTER_PREPARE_ONLY QNATTER_RUNTIME_DIR QNATTER_RUNTIME_LIST QNATTER_ROUTE_SLOT QNATTER_ROUTE_MARK QNATTER_ROUTE_TABLE QNATTER_ROUTE_PRIORITY

	old_list="${RUN_DIR}/.runtime-instances"
	old_sorted="${tmp}/.old-sorted"
	new_sorted="${tmp}/.new-sorted"
	sort "$old_list" 2>/dev/null > "$old_sorted" || : > "$old_sorted"
	sort "$runtime_list" 2>/dev/null > "$new_sorted" || : > "$new_sorted"
	if ! cmp -s "$old_sorted" "$new_sorted"; then
		rm -rf "$tmp"
		return 1
	fi

	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		if ! cmp -s "${RUN_DIR}/${slug}.runtime" "${tmp}/${slug}.runtime"; then
			rm -rf "$tmp"
			return 1
		fi
	done < "$runtime_list"

	cp "$runtime_list" "$old_list" 2>/dev/null || true
	rm -rf "$tmp"
	return 0
}

reload_service() {
	local enabled hot_reload tmp old_list new_list slug section

	config_load "$CONF"
	# global 段缺失/被改名时 config_get_bool 只能返回默认值：旧代码会直接
	# stop，把正在运行的实例全部停掉。这里只在显式 enabled=0 时停止。
	qnatter_config_get_bool enabled global enabled ""
	if [ -z "$enabled" ]; then
		qnatter_warn "qnatter: global section missing, keeping current instances"
		enabled=1
	fi
	if [ "$enabled" != "1" ]; then
		stop
		return 0
	fi

	if ! qnatter_lock_acquire; then
		qnatter_warn "qnatter: another reload is already running, skipping"
		return 0
	fi

	# global.hot_reload=1：实例集合与运行时指纹都没变时不触碰 procd；
	# hot_reload=0：始终走完整的 Phase 1-4 重新声明（强制重启语义）。
	qnatter_config_get_bool hot_reload global hot_reload 1
	if qnatter_bool "$hot_reload" && qnatter_hot_reload_service; then
		return 0
	fi

	qnatter_load_global_stun_servers
	qnatter_prepare_route_slots || return 1
	mkdir -p "$RUN_DIR"

	tmp="$(mktemp -d "${RUN_DIR}/.reload.XXXXXX")" || return 1
	old_list="${RUN_DIR}/.runtime-instances"
	[ -f "$old_list" ] || : > "$old_list"

	# Phase 1: prepare new fingerprints (PREPARE_ONLY)
	QNATTER_PREPARE_ONLY=1
	QNATTER_RUNTIME_DIR="$tmp"
	QNATTER_RUNTIME_LIST="${tmp}/.runtime-instances"
	QNATTER_ROUTE_SLOT=0
	qnatter_foreach_instance qnatter_start_instance
	if qnatter_instances_failed; then
		rm -rf "$tmp"
		unset QNATTER_PREPARE_ONLY QNATTER_RUNTIME_DIR QNATTER_RUNTIME_LIST QNATTER_ROUTE_SLOT QNATTER_ROUTE_MARK QNATTER_ROUTE_TABLE QNATTER_ROUTE_PRIORITY
		return 1
	fi
	unset QNATTER_PREPARE_ONLY QNATTER_RUNTIME_DIR QNATTER_RUNTIME_LIST QNATTER_ROUTE_SLOT QNATTER_ROUTE_MARK QNATTER_ROUTE_TABLE QNATTER_ROUTE_PRIORITY
	new_list="${tmp}/.runtime-instances"
	# 一个实例都没有（全部被删除/禁用）时上面的 loop 不会创建列表文件，
	# Phase 2/3 的 `done < "$new_list"` 会因文件不存在而报错。
	[ -f "$new_list" ] || : > "$new_list"

	# Phase 2: stop removed instances (in old_list but not new_list)
	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		grep -Fqx "$slug" "$new_list" 2>/dev/null && continue
		section="$(grep '^section=' "${RUN_DIR}/${slug}.runtime" 2>/dev/null | cut -d= -f2)"
		[ -n "$section" ] && command -v "$QNATTER_UBUS_BIN" >/dev/null 2>&1 && \
			"$QNATTER_UBUS_BIN" call service delete "{ \"name\": \"qnatter\", \"instance\": \"${section}\" }" >/dev/null 2>&1 || true
	done < "$old_list"

	# Phase 3: stop changed instances (different fingerprint)
	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		[ -f "${RUN_DIR}/${slug}.runtime" ] || continue
		cmp -s "${RUN_DIR}/${slug}.runtime" "${tmp}/${slug}.runtime" 2>/dev/null && continue
		section="$(grep '^section=' "${tmp}/${slug}.runtime" 2>/dev/null | cut -d= -f2)"
		[ -n "$section" ] && command -v "$QNATTER_UBUS_BIN" >/dev/null 2>&1 && \
			"$QNATTER_UBUS_BIN" call service delete "{ \"name\": \"qnatter\", \"instance\": \"${section}\" }" >/dev/null 2>&1 || true
	done < "$new_list"

	# 被删除实例的 nft 规则与策略路由不会由 procd 回收：新列表为空（实例全部
	# 被删除或禁用）时直接清理本包的规则，避免残留 DNAT 黑洞与 ip rule。
	if [ ! -s "$new_list" ]; then
		qnatter_flush_runtime_rules
		qnatter_flush_route_rules
	fi

	# Phase 4: start procd instances via a fresh init script invocation
	# procd captures stdout from the external command and diffs declarations
	if ! QNATTER_RELOADING=1 "$QNATTER_INIT_BIN" start >/dev/null 2>&1; then
		qnatter_warn "qnatter: reload failed to restart instances, keeping previous state"
		rm -rf "$tmp"
		return 1
	fi

	cp "$new_list" "$old_list" 2>/dev/null || true
	rm -rf "$tmp"
	return 0
}
